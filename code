// =====================================================
// 6. STRUCTURED LOGGING
// =====================================================
void logTransition(SystemState oldState, SystemState newState) {
  stateTransitionCount++;

  Serial.print("{\"timestamp_ms\":");
  Serial.print(millis());

  Serial.print(",\"event\":\"STATE_TRANSITION\"");
  Serial.print(",\"transition_number\":");
  Serial.print(stateTransitionCount);

  Serial.print(",\"previous_state\":\"");
  Serial.print(stateName(oldState));

  Serial.print("\",\"new_state\":\"");
  Serial.print(stateName(newState));

  Serial.print("\",\"fault_id\":\"");
  Serial.print(faultName(faultId));

  Serial.print("\",\"fault_source\":\"");
  Serial.print(sourceName(faultSource));

  Serial.println("\"}");

  // Preserve every transition as a separate queue event.
  enqueueCurrentEvent();
}

void changeState(SystemState next) {
  if (next == systemState) return;

  SystemState previous = systemState;

  systemState = next;
  stateEntryTime = millis();

  logTransition(previous, next);
}

void latchFault(FaultId id, FaultSource source) {
  // Keep the first active fault until recovery succeeds.
  if (faultId != NO_FAULT) return;

  faultId = id;
  faultSource = source;
  faultCount++;

  Serial.print("{\"timestamp_ms\":");
  Serial.print(millis());

  Serial.print(",\"event\":\"FAULT_DETECTED\"");
  Serial.print(",\"fault_number\":");
  Serial.print(faultCount);

  Serial.print(",\"fault_id\":\"");
  Serial.print(faultName(id));

  Serial.print("\",\"fault_source\":\"");
  Serial.print(sourceName(source));

  Serial.println("\"}");

  enqueueCurrentEvent();
}

// =====================================================
// 7. BATTERY MONITORING
// =====================================================
float adcToVoltage(int raw) {
  // Wokwi demonstration only.
  // Potentiometer position simulates 3.0-4.2 V.
  return 3.0 + (raw / 4095.0) * 1.2;
}

void readSensors() {
  int pins[4] = {
    CELL1_PIN, CELL2_PIN, CELL3_PIN, CELL4_PIN
  };

  float total = 0;
  weakestCell = 99.0;
  strongestCell = 0.0;

  for (int i = 0; i < 4; i++) {
    int value = analogRead(pins[i]);

    if (i == 0 && testMode == TEST_FROZEN_ADC &&
        previousADC[0] >= 0) {
      value = previousADC[0];
    }

    if (i == 0 && testMode == TEST_ADC_RANGE) {
      value = 4095;
    }

    rawADC[i] = value;
    cellVoltage[i] = adcToVoltage(value);

    if (testMode == TEST_ADC_RANGE && i == 0) {
      latchFault(ADC_OUT_OF_RANGE, SOURCE_ADC);
    }

    if (previousADC[i] == value) {
      if (adcUnchangedSince[i] == 0) {
        adcUnchangedSince[i] = millis();
      }

      if (testMode == TEST_FROZEN_ADC && i == 0 &&
          millis() - adcUnchangedSince[i] >= ADC_FROZEN_TIME) {
        latchFault(ADC_FROZEN, SOURCE_ADC);
      }
    } else {
      previousADC[i] = value;
      adcUnchangedSince[i] = millis();
    }

    total += cellVoltage[i];

    if (cellVoltage[i] < weakestCell) {
      weakestCell = cellVoltage[i];
    }

    if (cellVoltage[i] > strongestCell) {
      strongestCell = cellVoltage[i];
    }
  }

  averageVoltage = total / 4.0;
  imbalance = strongestCell - weakestCell;

  if (imbalance > 0.20) {
    latchFault(CELL_IMBALANCE, SOURCE_BATTERY_CELL);
  }
}

// =====================================================
// 8. RISK SCORE, SOC AND BATTERY HEALTH
// =====================================================
float calculateSOC() {
  // Demonstration estimate only.
  // Real battery SOC requires chemistry-specific calibration
  // and usually current integration or a fuel-gauge IC.
  float soc = ((averageVoltage - 3.0) / 1.2) * 100.0;

  if (soc < 0) soc = 0;
  if (soc > 100) soc = 100;

  return soc;
}

void calculateAnalytics() {
  estimatedSOC = calculateSOC();

  // Component 1: cell imbalance risk, maximum 40 points.
  float imbalanceRisk = (imbalance / 0.30) * 40.0;
  if (imbalanceRisk > 40) imbalanceRisk = 40;
  if (imbalanceRisk < 0) imbalanceRisk = 0;

  // Component 2: fault frequency proxy, maximum 30 points.
  // Each fault detected during this runtime adds 5 points.
  float faultRisk = faultCount * 5.0;
  if (faultRisk > 30) faultRisk = 30;

  // Component 3: low/high estimated SOC risk, maximum 30.
  float socRisk = 0;

  if (estimatedSOC < 20) {
    socRisk = (20 - estimatedSOC) * 1.5;
  } else if (estimatedSOC > 95) {
    socRisk = (estimatedSOC - 95) * 0.6;
  }

  if (socRisk > 30) socRisk = 30;
  if (socRisk < 0) socRisk = 0;

  riskScore = imbalanceRisk + faultRisk + socRisk;

  if (riskScore > 100) riskScore = 100;

  batteryHealth = 100.0 - riskScore;

  // Critical backend states must always indicate high risk.
  if (systemState == FAILSAFE || systemState == SHUTDOWN) {
    if (riskScore < 80) riskScore = 80;
    batteryHealth = 100.0 - riskScore;
  }
}

// =====================================================
// 9. INTELLIGENT OPERATOR RECOMMENDATIONS
// =====================================================
String getRecommendation() {
  if (systemState == SHUTDOWN) {
    return "Shutdown latched; inspect system";
  }

  if (systemState == FAILSAFE) {
    if (faultId == RELAY_MISMATCH) {
      return "Inspect relay and feedback";
    }

    if (faultId == ADC_FROZEN ||
        faultId == ADC_OUT_OF_RANGE) {
      return "Inspect ADC and sensor wiring";
    }

    if (faultId == COMMUNICATION_FAILURE) {
      return "Check communication connection";
    }

    return "Keep relay off; inspect fault";
  }

  if (systemState == DEGRADED ||
      faultId == CELL_IMBALANCE) {
    return "Check cell balance and wiring";
  }

  if (estimatedSOC < 20) {
    return "Estimated SOC low; inspect pack";
  }

  if (imbalance > 0.10) {
    return "Monitor cell voltage imbalance";
  }

  if (riskScore >= 50) {
    return "Review battery risk indicators";
  }

  return "No action; continue monitoring";
}

// =====================================================
// 10. RELAY FEEDBACK
// =====================================================
bool getRelayFeedback() {
  if (testMode == TEST_RELAY_MISMATCH) {
    return !relayCommand;
  }

  return digitalRead(RELAY_FEEDBACK) == HIGH;
}

void checkRelay() {
  if (systemState == SHUTDOWN) return;

  if (getRelayFeedback() != relayCommand) {
    if (relayMismatchStart == 0) {
      relayMismatchStart = millis();
    }

    if (millis() - relayMismatchStart >= 500) {
      latchFault(RELAY_MISMATCH, SOURCE_RELAY);
    }
  } else {
    relayMismatchStart = 0;
  }
}

// =====================================================
// 11. OFFLINE FIFO QUEUE
// =====================================================
void enqueueEvent(const TelemetryEvent &event) {
  if (queueCount >= QUEUE_CAPACITY) {
    droppedEvents++;

    Serial.print("{\"event\":\"QUEUE_FULL\"");
    Serial.print(",\"dropped_events\":");
    Serial.print(droppedEvents);
    Serial.println("}");

    return;
  }

  eventQueue[queueTail] = event;
  queueTail = (queueTail + 1) % QUEUE_CAPACITY;
  queueCount++;

  Serial.print("{\"event\":\"TELEMETRY_QUEUED\"");
  Serial.print(",\"sequence\":");
  Serial.print(event.sequence);
  Serial.print(",\"queue_depth\":");
  Serial.print(queueCount);
  Serial.println("}");
}

bool dequeueEvent(TelemetryEvent &event) {
  if (queueCount == 0) return false;

  event = eventQueue[queueHead];
  queueHead = (queueHead + 1) % QUEUE_CAPACITY;
  queueCount--;

  return true;
}

// =====================================================
// 12. CAPTURE A TELEMETRY SNAPSHOT
// =====================================================
TelemetryEvent captureTelemetry() {
  TelemetryEvent e;

  e.sequence = nextSequence++;
  e.timestamp = millis();

  for (int i = 0; i < 4; i++) {
    e.cells[i] = cellVoltage[i];
  }

  e.weakest = weakestCell;
  e.strongest = strongestCell;
  e.imbalance = imbalance;

  e.soc = estimatedSOC;
  e.risk = riskScore;
  e.health = batteryHealth;

  e.faults = faultCount;
  e.uptimeSeconds = (millis() - bootTime) / 1000UL;

  e.relayStatus = relayCommand ? 1 : 0;
  e.rssi = WiFi.isConnected() ? WiFi.RSSI() : -100;

  e.state = systemState;
  e.fault = faultId;
  e.source = faultSource;

  e.recommendation = getRecommendation();

  e.wifiConnected = WiFi.isConnected();
  e.blynkConnected = Blynk.connected();

  return e;
}

void enqueueCurrentEvent() {
  calculateAnalytics();

  TelemetryEvent e = captureTelemetry();
  enqueueEvent(e);
}

// =====================================================
// 13. EVENT-DRIVEN CHANGE DETECTION
// =====================================================
bool telemetryChanged(
  const TelemetryEvent &a,
  const TelemetryEvent &b
) {
  if (a.state != b.state ||
      a.fault != b.fault ||
      a.source != b.source ||
      a.relayStatus != b.relayStatus ||
      a.wifiConnected != b.wifiConnected ||
      a.blynkConnected != b.blynkConnected) {
    return true;
  }

  if (fabs(a.weakest - b.weakest) >= CELL_CHANGE_THRESHOLD ||
      fabs(a.strongest - b.strongest) >= CELL_CHANGE_THRESHOLD ||
      fabs(a.imbalance - b.imbalance) >= CELL_CHANGE_THRESHOLD ||
      fabs(a.risk - b.risk) >= 2.0 ||
      fabs(a.soc - b.soc) >= 2.0) {
    return true;
  }

  if (abs(a.rssi - b.rssi) >= 5) return true;

  for (int i = 0; i < 4; i++) {
    if (fabs(a.cells[i] - b.cells[i]) >= CELL_CHANGE_THRESHOLD) {
      return true;
    }
  }

  return false;
}

void evaluateTelemetryEvent() {
  calculateAnalytics();

  TelemetryEvent current = captureTelemetry();

  if (!telemetryInitialized) {
    telemetryInitialized = true;
    lastReported = current;
    enqueueEvent(current);
    return;
  }

  if (telemetryChanged(current, lastReported)) {
    enqueueEvent(current);
    lastReported = current;
  }
}

// =====================================================
// 14. NONBLOCKING WIFI RECONNECTION
// =====================================================
void updateWiFi() {
  unsigned long now = millis();

  if (WiFi.status() != WL_CONNECTED) {
    if (wifiWasConnected) {
      Serial.println("{\"event\":\"WIFI_DISCONNECTED\"}");
      wifiWasConnected = false;
    }

    if (now - lastWiFiAttempt >= WIFI_RETRY_MS) {
      lastWiFiAttempt = now;

      Serial.println("{\"event\":\"WIFI_RECONNECT_ATTEMPT\"}");
      WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
    }
  } else if (!wifiWasConnected) {
    wifiWasConnected = true;

    Serial.print("{\"timestamp_ms\":");
    Serial.print(now);
    Serial.print(",\"event\":\"WIFI_CONNECTED\",\"rssi\":");
    Serial.print(WiFi.RSSI());
    Serial.println("}");
  }
}

// =====================================================
// 15. BLYNK CONNECTION MANAGEMENT
// =====================================================
void updateBlynk() {
  unsigned long now = millis();

  if (WiFi.status() != WL_CONNECTED) return;

  if (!Blynk.connected()) {
    if (blynkWasConnected) {
      Serial.println("{\"event\":\"BLYNK_DISCONNECTED\"}");
      blynkWasConnected = false;
    }

    if (now - lastBlynkAttempt >= BLYNK_RETRY_MS) {
      lastBlynkAttempt = now;
      Blynk.connect(1);
    }
  } else if (!blynkWasConnected) {
    blynkWasConnected = true;
    Serial.println("{\"event\":\"BLYNK_CONNECTED\"}");
  }
}

// =====================================================
// 16. SEND DASHBOARD SNAPSHOT
// =====================================================
void sendTelemetryToBlynk(
  const TelemetryEvent &e,
  const char* deliverySource
) {
  if (!Blynk.connected()) return;

  // Existing dashboard: V0-V13.
  Blynk.virtualWrite(V0, e.cells[0]);
  Blynk.virtualWrite(V1, e.cells[1]);
  Blynk.virtualWrite(V2, e.cells[2]);
  Blynk.virtualWrite(V3, e.cells[3]);

  Blynk.virtualWrite(V4, e.weakest);
  Blynk.virtualWrite(V5, e.strongest);

  Blynk.virtualWrite(V6, e.relayStatus);
  Blynk.virtualWrite(V7, stateName(e.state));

  Blynk.virtualWrite(
    V8, e.wifiConnected ? "CONNECTED" : "OFFLINE"
  );

  Blynk.virtualWrite(V9, e.rssi);
  Blynk.virtualWrite(V10, queueCount);
  Blynk.virtualWrite(V11, faultName(e.fault));
  Blynk.virtualWrite(V12, deliverySource);
  Blynk.virtualWrite(V13, e.imbalance);

  // Enterprise analytics: V14-V21.
  Blynk.virtualWrite(V14, e.risk);
  Blynk.virtualWrite(V15, e.soc);
  Blynk.virtualWrite(V16, e.health);
  Blynk.virtualWrite(V17, e.faults);
  Blynk.virtualWrite(V18, e.uptimeSeconds);
  Blynk.virtualWrite(V19, severityName());
  Blynk.virtualWrite(V20, e.recommendation);

  // Structured last-event summary.
  String summary = "Seq:";
  summary += String(e.sequence);
  summary += " ";
  summary += stateName(e.state);
  summary += " ";
  summary += faultName(e.fault);

  Blynk.virtualWrite(V21, summary);

  Serial.print("{\"timestamp_ms\":");
  Serial.print(millis());
  Serial.print(",\"event\":\"TELEMETRY_SENT\"");
  Serial.print(",\"sequence\":");
  Serial.print(e.sequence);
  Serial.print(",\"original_timestamp_ms\":");
  Serial.print(e.timestamp);
  Serial.print(",\"delivery\":\"");
  Serial.print(deliverySource);
  Serial.print("\",\"queue_depth\":");
  Serial.print(queueCount);
  Serial.println("}");
}

// =====================================================
// 17. QUEUE REPLAY AND HISTORICAL CHART SAMPLES
// =====================================================
void processTelemetryQueue() {
  if (!Blynk.connected()) return;

  unsigned long now = millis();

  if (now - lastQueueSend < QUEUE_SEND_MS) return;

  lastQueueSend = now;

  TelemetryEvent e;

  // Always replay queued events before fresh snapshots.
  if (dequeueEvent(e)) {
    sendTelemetryToBlynk(e, "QUEUED");
    Blynk.virtualWrite(V10, queueCount);
    return;
  }

  // No queued events: send a current live snapshot.
  TelemetryEvent live = captureTelemetry();
  sendTelemetryToBlynk(live, "LIVE");
}

void sendAnalyticsSample() {
  unsigned long now = millis();

  if (!Blynk.connected()) return;
  if (queueCount > 0) return;

  if (now - lastAnalyticsSample < ANALYTICS_INTERVAL) return;

  lastAnalyticsSample = now;

  calculateAnalytics();

  // These values can feed Blynk time-series charts.
  Blynk.virtualWrite(V14, riskScore);
  Blynk.virtualWrite(V15, estimatedSOC);
  Blynk.virtualWrite(V16, batteryHealth);

  Blynk.virtualWrite(V17, faultCount);
  Blynk.virtualWrite(V18, (millis() - bootTime) / 1000UL);
  Blynk.virtualWrite(V19, severityName());
  Blynk.virtualWrite(V20, getRecommendation());
  Blynk.virtualWrite(V10, queueCount);
}

// =====================================================
// 18. BUTTONS AND FAULT INJECTION
// =====================================================
void updateButtons() {
  bool clearReading = digitalRead(CLEAR_BUTTON);
  bool faultReading = digitalRead(FAULT_BUTTON);

  if (previousFaultButton == HIGH &&
      faultReading == LOW) {

    testMode = (TestMode)((testMode + 1) % 6);

    Serial.print("{\"timestamp_ms\":");
    Serial.print(millis());
    Serial.print(",\"event\":\"TEST_MODE_CHANGED\",\"mode\":");
    Serial.print((int)testMode);
    Serial.println("}");

    for (int i = 0; i < 4; i++) {
      adcUnchangedSince[i] = millis();
    }

    if (testMode == TEST_COMMUNICATION) {
      latchFault(COMMUNICATION_FAILURE, SOURCE_COMMUNICATION);
    }

    if (testMode == TEST_SHUTDOWN) {
      latchFault(SHUTDOWN_REQUEST, SOURCE_SYSTEM);
    }
  }

  if (previousClearButton == HIGH &&
      clearReading == LOW) {

    if (systemState == FAILSAFE ||
        systemState == DEGRADED) {

      recoveryRequested = true;
      recoveryStartTime = millis();

      Serial.println(
        "{\"event\":\"RECOVERY_VERIFICATION_STARTED\"}"
      );
    }
  }

  previousClearButton = clearReading;
  previousFaultButton = faultReading;
}

// =====================================================
// 19. FAULT STATE MACHINE AND RECOVERY
// =====================================================
bool criticalFault() {
  return faultId == ADC_OUT_OF_RANGE ||
         faultId == ADC_FROZEN ||
         faultId == RELAY_MISMATCH ||
         faultId == COMMUNICATION_FAILURE;
}

bool recoveryChecksPassed() {
  if (testMode != TEST_NONE) return false;

  for (int i = 0; i < 4; i++) {
    if (rawADC[i] <= 2 || rawADC[i] >= 4093) {
      return false;
    }
  }

  if (imbalance > 0.20) return false;

  relayCommand = false;
  digitalWrite(RELAY_PIN, LOW);

  return getRelayFeedback() == relayCommand;
}

void updateStateMachine() {
  // Shutdown is latched until an intentional restart.
  if (systemState == SHUTDOWN) return;

  if (faultId == SHUTDOWN_REQUEST) {
    changeState(SHUTDOWN);
    return;
  }

  if (criticalFault()) {
    changeState(FAILSAFE);
  } else if (faultId == CELL_IMBALANCE &&
             systemState == NORMAL) {
    changeState(DEGRADED);
  }

  if ((systemState == FAILSAFE ||
       systemState == DEGRADED) &&
      recoveryRequested) {

    if (recoveryChecksPassed()) {
      if (millis() - recoveryStartTime >= RECOVERY_INTERVAL) {
        Serial.println("{\"event\":\"RECOVERY_VERIFIED\"}");

        faultId = NO_FAULT;
        faultSource = SOURCE_NONE;
        recoveryRequested = false;

        if (imbalance > 0.20) {
          changeState(DEGRADED);
        } else {
          changeState(NORMAL);
        }
      }
    } else {
      recoveryStartTime = millis();
    }
  }
}

// =====================================================
// 20. RELAY AND LED OUTPUTS
// =====================================================
void updateOutputs() {
  if (systemState == FAILSAFE ||
      systemState == SHUTDOWN) {

    relayCommand = false;
    digitalWrite(RELAY_PIN, LOW);
    digitalWrite(LED_PIN, HIGH);

  } else {
    relayCommand = true;
    digitalWrite(RELAY_PIN, HIGH);
    digitalWrite(LED_PIN, LOW);
  }
}

// =====================================================
// 21. FLICKER-FREE LCD
// =====================================================
String fitLine(String text) {
  while (text.length() < 16) text += ' ';
  if (text.length() > 16) text = text.substring(0, 16);
  return text;
}

void writeChangedLine(int row, String text, String &oldText) {
  text = fitLine(text);

  if (oldText.length() != 16) {
    oldText = "                ";
  }

  for (int col = 0; col < 16; col++) {
    if (text[col] != oldText[col]) {
      lcd.setCursor(col, row);
      lcd.print(text[col]);
    }
  }

  oldText = text;
}

void updateLCD() {
  unsigned long now = millis();

  if (faultId != NO_FAULT ||
      systemState == FAILSAFE ||
      systemState == SHUTDOWN) {

    currentPage = 2;

  } else if (now - lastPageChange >= PAGE_INTERVAL) {
    currentPage = (currentPage + 1) % 3;
    lastPageChange = now;
  }

  if (now - lastLCDRefresh < LCD_INTERVAL) return;

  lastLCDRefresh = now;

  String line1;
  String line2;

  if (currentPage == 0) {
    line1 = "BMS ";
    line1 += stateName(systemState);

    line2 = "Pack:";
    line2 += String(averageVoltage * 4.0, 2);
    line2 += "V";

  } else if (currentPage == 1) {
    line1 = "W:";
    line1 += String(weakestCell, 2);
    line1 += " S:";
    line1 += String(strongestCell, 2);

    line2 = "Delta:";
    line2 += String(imbalance, 2);

  } else {
    line1 = "FAULT ";
    line1 += stateName(systemState);
    line2 = faultName(faultId);
  }

  writeChangedLine(0, line1, oldLine1);
  writeChangedLine(1, line2, oldLine2);
}

// =====================================================
// 22. SETUP
// =====================================================
void setup() {
  Serial.begin(115200);

  pinMode(RELAY_PIN, OUTPUT);
  pinMode(RELAY_FEEDBACK, INPUT);
  pinMode(LED_PIN, OUTPUT);

  pinMode(CLEAR_BUTTON, INPUT_PULLUP);
  pinMode(FAULT_BUTTON, INPUT_PULLUP);

  analogReadResolution(12);

  Wire.begin(21, 22);
  lcd.init();
  lcd.backlight();

  lcd.setCursor(0, 0);
  lcd.print("MODULAR BMS");
  lcd.setCursor(0, 1);
  lcd.print("Starting...");

  bootTime = millis();

  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  Blynk.config(BLYNK_AUTH_TOKEN);

  lastWiFiAttempt = millis();
  lastBlynkAttempt = millis();
  lastSensorRead = millis();
  lastLCDRefresh = millis();
  lastPageChange = millis();
  stateEntryTime = millis();

  relayCommand = false;
  digitalWrite(RELAY_PIN, LOW);

  Serial.println(
    "{\"event\":\"BMS_STARTED\",\"analytics\":\"ENABLED\"}"
  );
}

// =====================================================
// 23. MAIN LOOP
// =====================================================
void loop() {
  updateWiFi();
  updateBlynk();

  if (Blynk.connected()) {
    Blynk.run();
  }

  updateButtons();

  unsigned long now = millis();

  if (now - lastSensorRead >= SENSOR_INTERVAL) {
    lastSensorRead = now;

    readSensors();
    checkRelay();
  }

  updateStateMachine();
  updateOutputs();

  calculateAnalytics();
  evaluateTelemetryEvent();

  processTelemetryQueue();
  sendAnalyticsSample();

  updateLCD();
}
